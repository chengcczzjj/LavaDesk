{
  "name": "lava-desk",
  "productName": "LavaDesk",
  "version": "1.2.0",
  "private": true,
  "description": "LavaDesk — Windows 桌面 AI 伴侣（动态壁纸 / 桌面组件 / 桌宠）",
  "main": "./out/main/index.js",
  "author": "chengcczzjj",
  "license": "MIT",
  "scripts": {
    "dev": "chcp 65001 >nul && cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -w",
    "format": "prettier --write --list-different .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "typecheck": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && tsc --noEmit -p tsconfig.web.json --tsBuildInfoFile out/tsconfig.web.tsbuildinfo && tsc --noEmit -p tsconfig.node.json --tsBuildInfoFile out/tsconfig.node.tsbuildinfo",
    "check": "npm run typecheck && npm run lint:check",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "npm run check && npm run test:unit",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "vite:build": "electron-vite build",
    "build:check": "npm run vite:build",
    "build:win": "npm run vite:build && electron-builder --win --config.win.signExecutable=false",
    "build:win:signed": "npm run vite:build && electron-builder --win",
    "build:dir": "npm run vite:build && electron-builder --dir --config.win.signExecutable=false",
    "test:electron:smoke": "npm run build:check && node tests/electron/run-smoke.mjs",
    "eval:companion": "node --experimental-strip-types scripts/companion-eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "exceljs": "4.4.0",
    "framer-motion": "^12.38.0",
    "koffi": "^2.16.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "ulidx": "^2.4.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.2",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "electron-as-wallpaper": "^1.0.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.3",
    "cross-env": "^10.1.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "brace-expansion@<2": "1.1.16",
    "brace-expansion@>=2 <3": "2.1.2",
    "brace-expansion@>=5 <6": "5.0.9",
    "fast-uri@3": "3.1.5",
    "nanoid@>=5 <6": "5.1.16",
    "tmp@0.2": "0.2.7",
    "uuid": "11.1.1",
    "archiver": "7.0.1",
    "archiver-utils": "5.0.2",
    "glob": "11.1.0",
    "minimatch": "10.2.5",
    "rimraf": "6.1.3",
    "zip-stream": "7.0.5",
    "@babel/core": "7.29.7",
    "form-data": "4.0.6",
    "ip-address": "10.3.1",
    "js-yaml": "5.2.2",
    "postcss": "8.5.23",
    "tar": "7.5.22",
    "esbuild": "0.28.1"
  }
}
